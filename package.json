{
  "name": "hku-voxel-campus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A data-informed block-scale digital recreation of The University of Hong Kong.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data:fetch": "tsx scripts/fetch-osm.ts && tsx scripts/fetch-official.ts && tsx scripts/fetch-landsd-buildings.ts && tsx scripts/fetch-terrain.ts",
    "data:process": "tsx scripts/process-osm.ts",
    "data:terrain": "tsx scripts/build-terrain.ts",
    "data:world": "tsx scripts/build-voxel-world.ts",
    "data:build": "npm run data:process && npm run data:terrain && npm run data:world",
    "data:all": "npm run data:fetch && npm run data:build"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.3.0",
    "@react-three/fiber": "^9.8.2",
    "fflate": "^0.8.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@turf/turf": "^7.4.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/proj4": "^2.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "osmtogeojson": "^3.0.0-beta.5",
    "prettier": "^3.9.10",
    "proj4": "^2.22.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
